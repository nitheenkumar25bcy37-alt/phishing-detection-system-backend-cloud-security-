{
  "manifest_version": 3,
  "name": "Phishing Guard - DOM Test (Member 2)",
  "version": "0.1",
  "description": "Test harness for Member 2's DOM/webpage analysis pipeline.",
  "permissions": [],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
